generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id                        String                      @id @default(uuid())
  userId                    String?
  user                      User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                      String
  icon                      String?
  color                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  subCategories             SubCategory[]

  @@unique([userId, name])
}

model SubCategory {
  id                        String                      @id @default(uuid())
  categoryId                String
  category                  Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                      String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
}

model HeadAccount {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}


enum UserRole {
  USER
  ADMIN
}

enum AccountType {
  BANK_ACCOUNT
  OVERDRAFT
  CREDIT_CARD
  DEBIT_CARD
  CASH_ACCOUNT
  CASH_CARD
  OTHER
}

model User {
  id               String                     @id @default(uuid())
  email            String                     @unique
  passwordHash     String
  name             String?
  role             UserRole                   @default(USER)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  emailTokens      EmailVerificationToken[]
  passwordTokens   PasswordResetToken[]
  categories       Category[]
  bankConnections  BankConnection[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  bankTransactionMeta BankTransactionMeta[]
  merchantRules    MerchantCategoryRule[]
  headAccounts     HeadAccount[]
  accountMetas     AccountMeta[]
  sensitiveInfos   SensitiveInfo[]
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}


// Open Banking (TrueLayer or other providers)
model BankConnection {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // e.g., "truelayer"
  providerAccountId String // Provider connection id
  accessToken       String // Encrypted/tokenized at app layer
  refreshToken      String?
  institutionId     String?
  status            String        @default("active") // active, revoked, error
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  accounts          BankAccount[]
}

model BankAccount {
  id                       String                      @id @default(uuid())
  userId                   String
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId             String
  connection               BankConnection              @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerAccountId        String // account id from provider
  type                     String? // card, checking, savings, etc.
  name                     String?
  productCode              String?
  planName                 String?
  benefitsJson             String?
  tags                     String?
  currency                 String?
  mask                     String? // last4 or masked number
  accountNumber            String?
  sortCode                 String?
  balance                  Float                       @default(0)
  availableBalance         Float?
  limit                    Float?
  statementBalance         Float?
  statementDate            DateTime?
  statementDueDate         DateTime?
  statementPaidAmount      Float?
  status                   String                      @default("active")
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  transactions             BankTransaction[]
  accountMetas             AccountMeta[]

  @@unique([userId, providerAccountId])
}

model BankTransaction {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  account               BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerTransactionId String
  amount                Float
  currency              String?
  descriptionVia        String?      @map("description")
  merchant              String?
  category              String?
  direction             String?      @default("debit")
  date                  DateTime
  pending               Boolean     @default(false)
  runningBalance        Float?
  raw                   String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  meta                  BankTransactionMeta?

  @@unique([userId, providerTransactionId])
}

model BankTransactionMeta {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankTransactionId  String          @unique
  bankTransaction    BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  openingBalance     Float?
  closingBalance     Float?
  fromEntity         String?
  viaEntity          String?
  toEntity           String?
  headAccount        String?
  subCategory        String?
  remarks            String?
  attachmentsJson    String?
  comments           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model AccountMeta {
  id                  String          @id @default(uuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedBankAccountId String?
  linkedBankAccount   BankAccount?    @relation(fields: [linkedBankAccountId], references: [id], onDelete: SetNull)
  parentAccountId     String?
  parentAccount       AccountMeta?    @relation("AccountMetaParent", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts       AccountMeta[]   @relation("AccountMetaParent")
  accountType         AccountType
  label               String
  accountHolderName   String?
  bankName            String?
  currency            String?
  internationalAccountNumber String?
  accountNumber       String?
  sortCode            String?
  balance             Float?
  availableBalance    Float?
  limit               Float?
  cardNetwork         String?
  cardLast4           String?
  cardImageUrl        String?
  documentImageUrls   String[]
  statementDay        Int?
  dueDay              Int?
  last3StatementDates String?
  last3DueDates       String?
  status              String          @default("active")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  sensitiveInfos      SensitiveInfo[]
}

model SensitiveInfo {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountMetaId    String
  accountMeta      AccountMeta @relation(fields: [accountMetaId], references: [id], onDelete: Cascade)
  encryptedPayload String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model MerchantCategoryRule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey String
  category    String
  source      String   @default("provider")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, merchantKey])
}
