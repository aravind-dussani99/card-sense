generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id                       String                      @id @default(uuid())
  userId                   String
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  nameOnCard               String? // Name printed on the card
  bank                     String
  bankId                   String?
  bankRef                  Bank?                       @relation(fields: [bankId], references: [id], onDelete: SetNull)
  cardTypeId               String? // Network (Visa, Mastercard, Amex)
  cardType                 CardType?                   @relation(fields: [cardTypeId], references: [id], onDelete: SetNull)
  cardCategory             String? // Card type/category (Rupay, PhonePe, IndianOil, Rewards, Amazon, etc.)
  productCode              String?
  planName                 String?
  benefitsJson             String?
  tags                     String?
  last4                    String
  fullCardNumber           String? // Full card number (encrypted/hidden)
  expiryDate               String? // Format: "MM/YY" or "10/29"
  cvv                      String? // CVV (encrypted/hidden)
  statementPassword        String? // Password for encrypted statement PDFs
  limit                    Float
  balance                  Float                       @default(0)
  cutoffDate               Int
  dueDate                  Int
  last3DueDates            String? // JSON array of last 3 due dates for prediction
  color                    String                      @default("bg-gray-800")
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  credential               CardCredential?
}

model Category {
  id                        String                      @id @default(uuid())
  userId                    String?
  user                      User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                      String
  icon                      String?
  color                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  subCategories             SubCategory[]

  @@unique([userId, name])
}

model SubCategory {
  id                        String                      @id @default(uuid())
  categoryId                String
  category                  Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                      String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
}

model HeadAccount {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model CardType {
  id        String   @id @default(uuid())
  name      String   @unique // This IS the network (e.g., "Mastercard", "Visa", "American Express")
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
}

model Bank {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
}


enum UserRole {
  USER
  ADMIN
}

model User {
  id               String                     @id @default(uuid())
  email            String                     @unique
  passwordHash     String
  name             String?
  role             UserRole                   @default(USER)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  emailTokens      EmailVerificationToken[]
  passwordTokens   PasswordResetToken[]
  cards            Card[]
  categories       Category[]
  bankConnections  BankConnection[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  bankTransactionMeta BankTransactionMeta[]
  bankAccountCredentials BankAccountCredential[]
  cardCredentials  CardCredential[]
  merchantRules    MerchantCategoryRule[]
  headAccounts     HeadAccount[]
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}


// Open Banking (TrueLayer or other providers)
model BankConnection {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // e.g., "truelayer"
  providerAccountId String // Provider connection id
  accessToken       String // Encrypted/tokenized at app layer
  refreshToken      String?
  institutionId     String?
  status            String        @default("active") // active, revoked, error
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  accounts          BankAccount[]
}

model BankAccount {
  id                       String                      @id @default(uuid())
  userId                   String
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId             String
  connection               BankConnection              @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerAccountId        String // account id from provider
  type                     String? // card, checking, savings, etc.
  name                     String?
  productCode              String?
  planName                 String?
  benefitsJson             String?
  tags                     String?
  currency                 String?
  mask                     String? // last4 or masked number
  accountNumber            String?
  sortCode                 String?
  balance                  Float                       @default(0)
  availableBalance         Float?
  limit                    Float?
  statementBalance         Float?
  statementDate            DateTime?
  statementDueDate         DateTime?
  statementPaidAmount      Float?
  status                   String                      @default("active")
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  transactions             BankTransaction[]
  credentials              BankAccountCredential?

  @@unique([userId, providerAccountId])
}

model BankTransaction {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  account               BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerTransactionId String
  amount                Float
  currency              String?
  descriptionVia        String?      @map("description")
  merchant              String?
  category              String?
  direction             String?      @default("debit")
  date                  DateTime
  pending               Boolean     @default(false)
  runningBalance        Float?
  raw                   String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  meta                  BankTransactionMeta?

  @@unique([userId, providerTransactionId])
}

model BankTransactionMeta {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankTransactionId  String          @unique
  bankTransaction    BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  openingBalance     Float?
  closingBalance     Float?
  fromEntity         String?
  viaEntity          String?
  toEntity           String?
  headAccount        String?
  subCategory        String?
  remarks            String?
  attachmentsJson    String?
  comments           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model BankAccountCredential {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId    String       @unique
  bankAccount      BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  label            String?
  encryptedPayload String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model MerchantCategoryRule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey String
  category    String
  source      String   @default("provider")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, merchantKey])
}

model CardCredential {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId           String   @unique
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label            String?
  encryptedPayload String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
